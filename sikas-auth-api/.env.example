# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
DATABASE_URL=postgresql://sikas_admin:password123@localhost:5432/sikas_auth

# ---------------------------------------------------------------
# Redis
# ---------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------
# JWT
# ---------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ---------------------------------------------------------------
# Email (SMTP) — free via Gmail, 500 messages/day
#
# Setup:
#   1. Turn on 2-Step Verification: myaccount.google.com/security
#   2. Create an App Password:      myaccount.google.com/apppasswords
#   3. Paste the 16-character password into SMTP_PASS (spaces are fine to strip)
#
# Leave these unset in development — emails print to the console instead.
# Any other SMTP provider works by changing SMTP_HOST/SMTP_PORT.
# ---------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=Sikas Admin <you@gmail.com>

# Base URL of the admin frontend, used to build password-reset links
APP_URL=http://localhost:5173

# ---------------------------------------------------------------
# SMS (optional, paid) — Twilio
#
# SMS MFA is optional. The free path is email OTP (/send-email-otp),
# which uses the SMTP settings above. Fill these in only if you want
# text-message codes as well.
# ---------------------------------------------------------------
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
NODE_ENV=development
PORT=9000
HOST=0.0.0.0
LOG_LEVEL=info
