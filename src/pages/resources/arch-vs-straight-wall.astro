import Article from '../../layouts/Article.astro';

const toc = [
  { id: 'how', label: 'How each one works' },
  { id: 'floor', label: 'The floor space question' },
  { id: 'cost', label: 'Cost' },
  { id: 'doors', label: 'Doors and openings' },
  { id: 'pick', label: 'How to choose' },
