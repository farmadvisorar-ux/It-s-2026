const regions = [
  { name: 'Heavy snow states', list: 'Alaska, Colorado, Idaho, Maine, Michigan, Minnesota, Montana, New Hampshire, New York, North Dakota, Utah, Vermont, Wisconsin, Wyoming', note: 'Ground snow load drives the roof design and can vary dramatically with elevation inside a single county.' },
  { name: 'High wind & hurricane', list: 'Alabama, Florida, Georgia, Louisiana, Mississippi, North Carolina, South Carolina, Texas, Virginia', note: 'Coastal counties carry higher design wind speeds and often additional wind-borne debris requirements.' },
