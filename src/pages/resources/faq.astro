---
import Base from '../../layouts/Base.astro';
import faqs from '../../data/faqs.json';

const items = faqs as any[];
const categories = [...new Set(items.map((f) => f.category))];

// FAQPage structured data — helps these surface as rich results
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Frequently Asked Questions"
  description="Answers on steel building pricing, engineering, permits, foundations, assembly, insulation, delivery and maintenance."
  crumbs={[{ label: 'Resources', href: '/resources/' }]}
  current="FAQ"
>
  <section class="section">
    <div class="wrap faq-grid">
      <aside class="toc">
        <h2 class="toc__head">Topics</h2>
        <nav aria-label="FAQ categories">
          <ul>
            {categories.map((c) => (
              <li><a href={`#${c.toLowerCase().replace(/[^a-z]+/g, '-')}`}>{c}</a></li>
            ))}
          </ul>
        </nav>
        <div class="toc__cta">
          <p>Question not answered here?</p>
          <a class="btn btn--primary" href="/contact/" style="width:100%;justify-content:center">Ask us directly</a>
        </div>
      </aside>

      <div>
        <p class="eyebrow">Resources</p>
        <h1 class="page-title">Frequently Asked Questions</h1>
        <p class="lede">
          {items.length} answers covering what people actually ask before ordering — pricing,
          permits, foundations, condensation, assembly and what happens when the truck arrives.
        </p>

        <div class="search-wrap">
          <label class="visually-hidden" for="faq-search">Search questions</label>
          <input id="faq-search" type="search" placeholder="Search questions…" autocomplete="off" />
          <p class="search-count" aria-live="polite" hidden id="search-count"></p>
        </div>

        {categories.map((c) => (
          <section class="cat" id={c.toLowerCase().replace(/[^a-z]+/g, '-')}>
            <h2 class="cat__head">{c}</h2>
            {items.filter((f) => f.category === c).map((f) => (
              <details class="qa" data-q={f.q.toLowerCase()} data-a={f.a.toLowerCase()}>
                <summary>{f.q}</summary>
                <div class="qa__body"><p>{f.a}</p></div>
              </details>
            ))}
          </section>
        ))}

        <p class="no-results" id="no-results" hidden>No questions match that search.</p>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Base>

<style>
  .faq-grid { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .page-title { font-size: clamp(1.875rem, 4.5vw, 2.75rem); margin-block: 0.5rem 1rem; }

  .toc { position: sticky; top: 88px; }
  .toc__head { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-faint); margin-bottom: 0.875rem; }
  .toc ul { list-style: none; padding: 0; }
  .toc li { margin-bottom: 0.4375rem; }
  .toc a { font-size: 0.875rem; color: var(--text-muted); text-decoration: none; }
  .toc a:hover { color: var(--accent); }
  .toc__cta { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .toc__cta p { font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.75rem; }

  .search-wrap { margin: 2rem 0; }
  #faq-search {
    width: 100%; padding: 0.75rem 1rem;
    background: var(--bg-raised); border: 1px solid var(--border-strong);
    border-radius: var(--radius); font-size: 0.9375rem;
  }
  .search-count { margin-top: 0.5rem; font-size: 0.8125rem; color: var(--text-faint); }

  .cat { margin-bottom: 3rem; scroll-margin-top: 88px; }
  .cat__head {
    font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent);
    padding-bottom: 0.625rem; margin-bottom: 0.75rem; border-bottom: 1px solid var(--border);
  }
  .qa { border-bottom: 1px solid var(--border); }
  .qa summary {
    padding: 0.9375rem 2rem 0.9375rem 0; cursor: pointer; position: relative;
    font-weight: 600; font-size: 0.9375rem; list-style: none;
  }
  .qa summary::-webkit-details-marker { display: none; }
  .qa summary::after {
    content: '+'; position: absolute; right: 0.25rem; top: 0.875rem;
    font-size: 1.125rem; font-weight: 400; color: var(--accent); transition: transform 0.15s;
  }
  .qa[open] summary::after { content: '\2212'; }
  .qa summary:hover { color: var(--accent); }
  .qa__body { padding: 0 0 1.125rem; }
  .qa__body p { font-size: 0.9375rem; color: var(--text-muted); max-width: 68ch; }
  .no-results { text-align: center; padding: 2rem; color: var(--text-muted); }

  @media (max-width: 860px) {
    .faq-grid { grid-template-columns: 1fr; }
    .toc { position: static; }
    .toc nav ul { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .toc li { margin: 0; }
    .toc a { padding: 0.25rem 0.625rem; border: 1px solid var(--border); border-radius: 3px; display: inline-block; }
  }
</style>

<script>
  const search = document.getElementById('faq-search') as HTMLInputElement | null;
  const countEl = document.getElementById('search-count');
  const noRes = document.getElementById('no-results');

  search?.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    let shown = 0;

    document.querySelectorAll<HTMLElement>('.qa').forEach((el) => {
      const hit = !q || (el.dataset.q ?? '').includes(q) || (el.dataset.a ?? '').includes(q);
      el.hidden = !hit;
      if (hit) shown++;
      if (q && hit) el.setAttribute('open', ''); else if (q) el.removeAttribute('open');
    });

    // hide category headers with no visible questions
    document.querySelectorAll<HTMLElement>('.cat').forEach((cat) => {
      const any = [...cat.querySelectorAll<HTMLElement>('.qa')].some((el) => !el.hidden);
      cat.hidden = !any;
    });

    countEl.hidden = !q;
    countEl.textContent = `${shown} matching question${shown === 1 ? '' : 's'}`;
    noRes.hidden = shown > 0 || !q;
  });
</script>
