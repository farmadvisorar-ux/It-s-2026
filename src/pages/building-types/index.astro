---
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import types from '../../data/building-types.json';
import { typeImage } from '../../lib/images';

const groups = [...new Set((types as any[]).map((t) => t.group))];
---

<Base
  title="Steel Building Types"
  description="Every steel building type we supply — garages, workshops, barndominiums, quonset huts, container covers, agricultural, commercial and specialized structures."
  current="Building Types"
  crumbs={[]}
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Catalog</p>
      <h1 class="page-title">Steel Building Types</h1>
      <p class="lede">
        {types.length} building categories across residential, agricultural, commercial and
        specialized use. Every one of them is a pre-engineered kit, sized and stamped for
        the address it is going to.
      </p>

      <nav class="jump" aria-label="Jump to a group">
        {groups.map((g) => (
          <a href={`#${(g as string).toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{g}</a>
        ))}
      </nav>

      {groups.map((g) => (
        <div class="group" id={(g as string).toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
          <h2 class="group__head">{g}</h2>
          <div class="rows rows--compact">
            {(types as any[]).filter((t) => t.group === g).map((t) => (
              <a class="row" href={`/building-types/${t.slug}/`}>
                <div class="row__media">
                  <Placeholder label={t.name} src={typeImage(t.slug)} alt={`${t.name} — ${t.headline}`} />
                </div>
                <div class="row__body">
                  <h3 class="row__title">{t.name}</h3>
                  <p class="row__text">{t.headline}</p>
                  <span class="row__meta">
                    Common sizes {t.commonSizes[0]} – {t.commonSizes[t.commonSizes.length - 1]}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .page-title { font-size: clamp(2rem, 5vw, 3rem); margin-block: 0.5rem 1rem; }

  .jump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem; }
  .jump a {
    padding: 0.4375rem 0.9375rem;
    font-size: 0.875rem; font-weight: 600;
    text-decoration: none; color: var(--text-muted);
    background: var(--bg-sunken); border-radius: 999px;
  }
  .jump a:hover { color: var(--accent-contrast); background: var(--accent); }

  .group { margin-top: clamp(2.5rem, 6vw, 4rem); scroll-margin-top: 1.5rem; }
  .group__head {
    font-family: var(--font-sans);
    font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--text-faint); margin-bottom: 0.75rem;
  }
</style>
