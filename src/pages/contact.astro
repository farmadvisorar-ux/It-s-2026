---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
---

<Base
  title="Contact Us"
  description="Get in touch with Any Size about a steel building project — sizing, pricing, engineering or delivery."
  crumbs={[]}
  current="Contact"
>
  <section class="section">
    <div class="wrap contact-grid">
      <div>
        <p class="eyebrow">Get in touch</p>
        <h1 class="page-title">Contact Us</h1>
        <p class="lede">
          If you already know roughly what you want built, the
          <a href="/quote/">quote form</a> collects the details we need and gets you a written
          number faster. For anything else, this reaches us directly.
        </p>

        <dl class="contact-details">
          {site.phone && (
            <div><dt>Phone</dt><dd><a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>{site.phone}</a></dd></div>
          )}
          {site.email && (
            <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          )}
          <div><dt>Hours</dt><dd>{site.hours}</dd></div>
          {site.address.city && (
            <div>
              <dt>Location</dt>
              <dd>{[site.address.street, site.address.city, site.address.region, site.address.postal].filter(Boolean).join(', ')}</dd>
            </div>
          )}
        </dl>

        {!site.phone && !site.email && (
          <div class="admin-note">
            <strong>Publish note — remove before launch.</strong> Add your phone number, email
            address and business location to <code>src/data/site.json</code>. They will appear
            here and in the footer automatically.
          </div>
        )}

        <div class="prose" style="margin-top:2rem">
          <h2>What is useful to tell us</h2>
          <ul>
            <li>What the building is for, and what goes inside it</li>
            <li>A rough size, if you have one in mind</li>
            <li>The delivery address — this determines the engineering</li>
            <li>Your timeline</li>
          </ul>
        </div>
      </div>

      <div class="form-wrap">
        {!endpoint && (
          <div class="notice" role="status">
            <strong>Form not yet connected.</strong> Set <code>PUBLIC_FORM_ENDPOINT</code> in
            your environment variables to start receiving messages.
          </div>
        )}

        <form class="contact-form" id="contact-form" method="POST" action={endpoint || undefined} novalidate>
          <div class="field">
            <label for="name">Name <span aria-hidden="true">*</span></label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">Email <span aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="postal">ZIP / Postal code</label>
            <input id="postal" name="postal" type="text" autocomplete="postal-code" />
          </div>
          <div class="field">
            <label for="message">How can we help? <span aria-hidden="true">*</span></label>
            <textarea id="message" name="message" rows="6" required></textarea>
          </div>

          <div class="visually-hidden" aria-hidden="true">
            <label for="company_website">Leave this blank</label>
            <input id="company_website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <button class="btn btn--primary btn--submit" type="submit">Send Message</button>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .page-title { font-size: clamp(2rem, 5vw, 3rem); margin-block: 0.5rem 1rem; }
  .lede a { color: var(--accent); }

  .contact-details { margin-top: 2rem; display: grid; gap: 1rem; }
  .contact-details dt { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-faint); }
  .contact-details dd { margin: 0.125rem 0 0; font-size: 1rem; }
  .contact-details a { color: var(--accent); text-decoration: none; }

  .form-wrap { background: var(--bg-raised); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: clamp(1.25rem, 3vw, 2rem); }
  .field { display: flex; flex-direction: column; gap: 0.375rem; margin-bottom: 1rem; }
  .field label { font-size: 0.8125rem; font-weight: 500; }
  .field label span { color: var(--accent); }
  input, textarea {
    padding: 0.625rem 0.75rem; width: 100%;
    background: var(--bg); border: 1px solid var(--border-strong);
    border-radius: var(--radius); font-size: 0.9375rem;
  }
  textarea { resize: vertical; }
  input[aria-invalid='true'], textarea[aria-invalid='true'] { border-color: #dc2626; }
  .err { font-size: 0.75rem; color: #dc2626; }
  .btn--submit { width: 100%; justify-content: center; padding-block: 0.875rem; }

  .notice, .admin-note {
    padding: 0.875rem 1rem; margin-bottom: 1.5rem;
    border-radius: var(--radius); font-size: 0.8125rem; color: var(--text-muted);
  }
  .notice {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .admin-note {
    margin-top: 1.5rem;
    background: color-mix(in srgb, #dc2626 8%, transparent);
    border: 1px dashed color-mix(in srgb, #dc2626 45%, transparent);
  }
  .admin-note strong { display: block; color: #dc2626; margin-bottom: 0.25rem; }
  code { font-family: var(--font-mono); font-size: 0.75rem; background: var(--bg-sunken); padding: 0.0625rem 0.25rem; border-radius: 2px; }

  .form-success {
    padding: 2rem; text-align: center;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: var(--radius-lg);
  }

  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    let ok = true;
    form.querySelectorAll('.err').forEach((n) => n.remove());

    form.querySelectorAll('[required]').forEach((el) => {
      const valid = el.value.trim() !== '' && (el.type !== 'email' || /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(el.value));
      el.setAttribute('aria-invalid', String(!valid));
      if (!valid) {
        ok = false;
        const msg = document.createElement('p');
        msg.className = 'err';
        msg.textContent = el.type === 'email' && el.value.trim() !== '' ? 'Enter a valid email address.' : 'This field is required.';
        el.parentElement.appendChild(msg);
      }
    });

    if (form.company_website.value !== '') { e.preventDefault(); return; }

    if (!ok) {
      e.preventDefault();
      form.querySelector('[aria-invalid="true"]')?.focus();
      return;
    }

    if (!form.getAttribute('action')) {
      e.preventDefault();
      form.insertAdjacentHTML('beforebegin', '<div class="form-success"><strong>Form endpoint not configured.</strong><p style="margin-top:.5rem;font-size:.875rem;color:var(--text-muted)">This message was not sent. Set PUBLIC_FORM_ENDPOINT to go live.</p></div>');
      form.style.display = 'none';
    }
  });
</script>
