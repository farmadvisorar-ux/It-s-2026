---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found" description="The page you were looking for does not exist.">
  <section class="section">
    <div class="wrap nf">
      <p class="eyebrow">404</p>
      <h1>That page does not exist</h1>
      <p class="lede">It may have moved, or the link may be wrong.</p>
      <div class="nf__links">
        <a class="btn btn--primary" href="/">Back to home</a>
        <a class="btn btn--ghost" href="/building-types/">Browse buildings</a>
        <a class="btn btn--ghost" href="/inventory/">See inventory</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { text-align: center; padding-block: clamp(2rem, 8vw, 5rem); }
  .nf h1 { font-size: clamp(1.75rem, 5vw, 2.75rem); margin-block: 0.5rem 1rem; }
  .nf .lede { margin-inline: auto; }
  .nf__links { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 2rem; }
</style>
