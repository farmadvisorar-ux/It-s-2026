---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import site from '../data/site.json';
import types from '../data/building-types.json';
import models from '../data/models.json';
import inventory from '../data/inventory.json';
import pb from '../data/portable-buildings.json';
import loc from '../data/locations.json';
import { typeImage, inventoryImage, heroImage, portableImage } from '../lib/images';

const deals = (inventory as any[]).filter((i) => i.featured).slice(0, 3);
const pbLine = (pb as any).line;
const locBase = (loc as any).base;
const locCounties = (loc as any).counties;
const locCities = (loc as any).cities;
const townCount = new Set(locCounties.flatMap((c: any) => c.communities)).size;
const pbCount = (pb as any).products.length;
const dealCount = (inventory as any[]).length;

// The header carries no mega menu, so the full type list lives here instead.
const groups = [...new Set((types as any[]).map((t) => t.group))];
const byGroup = (g: string) => (types as any[]).filter((t) => t.group === g);

const showPhone = Boolean(site.phone) && !site.phonePending;

const advantages = [
  {
    title: 'Factory-direct pricing',
    body: 'Kits ship from the plant nearest your jobsite. No middle distributor markup between the mill and your slab.',
  },
  {
    title: 'Engineer-stamped drawings',
    body: 'Every building is engineered to the wind, snow and seismic values at your specific address, and stamped for your jurisdiction.',
  },
  {
    title: 'Bolt-together assembly',
    body: 'Pre-punched panels and numbered parts. No welding, no specialized tooling — many owners raise their own building.',
  },
  {
    title: 'Non-combustible steel',
    body: '100% steel construction. Nothing to rot, nothing termites will eat, and nothing that feeds a fire.',
  },
];

const steps = [
  { n: '01', t: 'Tell us the job', b: 'Size, use, and where it is going. Location drives the engineering more than anything else.' },
  { n: '02', t: 'We quote the kit', b: 'A written quote covering the building, the options you picked, and freight to your site.' },
  { n: '03', t: 'Drawings and permit', b: 'Stamped drawings for your jurisdiction so your building department has what it needs.' },
  { n: '04', t: 'Delivery and build', b: 'Your kit ships to site. Assemble it yourself or bring in a local crew.' },
];
---

<Base title={site.name}>
  <!-- ================= HERO =================
       Full-bleed photograph with the contact card sitting over it, rather than
       a headline block beside a framed image. -->
  <section class="hero">
    <div class="hero__media">
      <Placeholder
        label="Steel building exterior"
        src={heroImage()}
        alt="Engineered steel building on a finished site"
        variant="wide"
      />
    </div>
    <div class="wrap hero__overlay">
      <div class="hero__card">
        <p class="eyebrow">Marshall, Texas</p>
        <h1 class="hero__title">Barns, sheds and steel buildings, sized to the job</h1>
        <p class="hero__lede">
          Wood portable buildings delivered finished and ready to use, and engineered steel
          kits shipped nationwide with stamped drawings. One dealer, two very different
          ways to get a building on your property.
        </p>
        <div class="hero__actions">
          {showPhone ? (
            <a class="btn btn--primary" href={`tel:${site.phoneRaw || site.phone}`}>Call {site.phone}</a>
          ) : (
            <a class="btn btn--primary" href="/quote/">Get a Free Quote</a>
          )}
          <a class="btn btn--ghost" href="/inventory/">Browse {dealCount} clearance buildings</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= THE TWO LINES ================= -->
  <section class="section">
    <div class="wrap">
      <div class="rows">
        <a class="row" href="/building-types/">
          <div class="row__media">
            <Placeholder label="Steel building" src={typeImage('workshops')} alt="Engineered steel workshop building" />
          </div>
          <div class="row__body">
            <p class="eyebrow">Line one — steel kits</p>
            <h2 class="row__title">Steel buildings, engineered to your site</h2>
            <p class="row__text">
              {types.length} categories, from a single-car garage to a 200-foot commercial
              span. Each one is engineered to the wind, snow and seismic loads at your
              address, then shipped as a bolt-together kit.
            </p>
            <span class="row__meta">Ships nationwide · Needs a foundation and a permit</span>
            <span class="row__more">See all {types.length} steel types &rarr;</span>
          </div>
        </a>

        <a class="row" href="/portable-buildings/">
          <div class="row__media">
            <Placeholder label="Portable building" src={portableImage('barn')} alt="Wood portable barn delivered finished" />
          </div>
          <div class="row__body">
            <p class="eyebrow">Line two — portable buildings</p>
            <h2 class="row__title">Delivered finished, ready to use</h2>
            <p class="row__text">
              {pbCount} models built in a shop and trucked to your property complete. No kit
              to assemble and no slab to pour — they sit on treated skids, so level ground is
              usually all the site prep you need, and the building can move if you do.
            </p>
            <span class="row__meta">Delivered in {pbLine.deliveryStates.join(', ')}</span>
            <span class="row__more">See all {pbCount} portable models &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= TYPE DIRECTORY ================= -->
  <section class="section section--sunken">
    <div class="wrap">
      <p class="eyebrow">Steel building catalog</p>
      <h2 class="sec-title">Every type we supply</h2>
      <div class="dir">
        {groups.map((g) => (
          <div class="dir__group">
            <h3 class="dir__head">{g}</h3>
            <ul>
              {byGroup(g).map((t: any) => (
                <li><a href={`/building-types/${t.slug}/`}>{t.name}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= ADVANTAGES ================= -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Why steel</p>
      <h2 class="sec-title">Built to a spec, not to a guess</h2>
      <div class="adv-grid">
        {advantages.map((a) => (
          <div class="adv">
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= INVENTORY ================= -->
  {deals.length > 0 && (
    <section class="section section--sunken">
      <div class="wrap">
        <header class="sec-head">
          <div>
            <p class="eyebrow">Clearance inventory</p>
            <h2>Kits ready to ship</h2>
          </div>
          <a class="btn btn--ghost" href="/inventory/">View all inventory</a>
        </header>
        <p class="lede" style="margin-bottom:2.5rem">
          Overstock and cancelled-order kits — structurally identical to a custom build,
          available at a discount because the steel is already made.
        </p>
        <div class="grid grid--3">
          {deals.map((d) => (
            <a class="card" href={`/inventory/${d.slug}/`}>
              <Placeholder label={d.title} src={inventoryImage(d.slug)} alt={`${d.title} steel building kit`} />
              <div class="card__body">
                <span class="tag tag--accent">Clearance</span>
                <h3 class="card__title">{d.title}</h3>
                {d.sqft && <span class="card__meta">{d.sqft.toLocaleString()} sq ft footprint</span>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ================= MODELS ================= -->
  <section class="section">
    <div class="wrap">
      <header class="sec-head">
        <div>
          <p class="eyebrow">Building models</p>
          <h2>Eight profiles, different jobs</h2>
        </div>
        <a class="btn btn--ghost" href="/models/">Compare models</a>
      </header>
      <p class="lede" style="margin-bottom:2.5rem">
        The profile determines how the building carries load — and how much of the floor you
        actually get to use. Arches are the most economical per square foot; straight walls
        give you usable height right to the wall line.
      </p>
      <ul class="modellist">
        {models.map((m: any) => (
          <li>
            <a href={`/models/${m.code.toLowerCase()}/`}>
              <span class="modellist__code">{m.code}</span>
              <span class="modellist__name">{m.name}</span>
              <span class="modellist__span">{m.spanRange}</span>
              <span class="modellist__profile">{m.profile}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= PROCESS ================= -->
  <section class="section section--sunken">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2 class="sec-title">From first call to finished building</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step">
            <span class="step__n">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.b}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================= SERVICE AREA ================= -->
  <section class="section">
    <div class="wrap">
      <header class="sec-head">
        <div>
          <p class="eyebrow">Based in {locBase.city}, {locBase.stateCode}</p>
          <h2>An East Texas business, not a call centre</h2>
        </div>
        <a class="btn btn--ghost" href="/service-area/">Full service area</a>
      </header>
      <p class="lede" style="margin-bottom:2.5rem">
        We deliver across {locCounties.length} East Texas counties — {townCount} communities
        in all. Steel building kits ship nationwide by freight; portable buildings are
        trucked complete, which keeps that line regional.
      </p>
      <div class="areas">
        {locCities.map((c: any) => (
          <a class="area" href={`/service-area/${c.slug}/`}>
            <strong>{c.name}</strong>
            <span>{c.county.replace(' County', ' Co.').replace(' Counties', ' Cos.')}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="cta">
    <div class="wrap cta__inner">
      <div>
        <h2>Tell us what you need built</h2>
        <p>
          Send us the size, the use and the location. We will come back with a written
          quote and the engineering questions worth answering before you pour anything.
        </p>
      </div>
      <a class="btn btn--primary btn--lg" href="/quote/">Request a Quote</a>
    </div>
  </section>
</Base>

<style>
  /* hero — the photograph runs the full width and the card sits on it */
  .hero { position: relative; }
  .hero__media :global(.ph-img), .hero__media :global(.ph) {
    width: 100%;
    aspect-ratio: 21 / 9;
    min-height: 420px;
    object-fit: cover;
  }
  .hero::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(100deg, rgba(43, 38, 34, 0.55) 0%, rgba(43, 38, 34, 0.15) 55%, transparent 100%);
    pointer-events: none;
  }
  .hero__overlay { position: absolute; inset: 0; display: flex; align-items: center; z-index: 1; }
  .hero__card {
    background: var(--bg-raised);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    max-width: 34rem;
  }
  .hero__title { font-size: clamp(1.75rem, 4vw, 2.75rem); margin-block: 0.625rem 0.875rem; }
  .hero__lede { color: var(--text-muted); font-size: 1.0625rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  @media (max-width: 860px) {
    .hero::after { background: linear-gradient(180deg, rgba(43, 38, 34, 0.35), rgba(43, 38, 34, 0.1)); }
    .hero__media :global(.ph-img), .hero__media :global(.ph) { aspect-ratio: 16 / 10; min-height: 0; }
    .hero__overlay { position: static; display: block; }
    .hero__card { max-width: none; margin-top: -3rem; position: relative; z-index: 2; }
  }

  /* section heads */
  .sec-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .sec-head h2, .sec-title { font-size: clamp(1.625rem, 3.6vw, 2.25rem); }
  .sec-title { margin-bottom: 2.5rem; }

  /* type directory — replaces the mega menu */
  .dir { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 2rem 2.5rem; }
  .dir__head {
    font-family: var(--font-sans);
    font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--text-faint); padding-bottom: 0.625rem; margin-bottom: 0.875rem;
    border-bottom: 1px solid var(--border);
  }
  .dir ul { list-style: none; padding: 0; }
  .dir li { margin-bottom: 0.375rem; }
  .dir a { font-size: 0.9375rem; color: var(--text-muted); text-decoration: none; }
  .dir a:hover { color: var(--accent); }

  /* advantages */
  .adv-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(195px, 1fr)); gap: 2.5rem; }
  .adv h3 { font-size: 1.125rem; margin-bottom: 0.5rem; }
  .adv h3::before {
    content: ''; display: block; width: 2rem; height: 3px; border-radius: 2px;
    background: var(--accent); margin-bottom: 0.875rem;
  }
  .adv p { font-size: 0.9375rem; color: var(--text-muted); }

  /* models — a list, not a card grid */
  .modellist { list-style: none; padding: 0; display: flex; flex-direction: column; }
  .modellist a {
    display: grid; grid-template-columns: 4rem 12rem 9rem 1fr;
    gap: 1rem; align-items: baseline;
    padding: 1rem 0.5rem; text-decoration: none;
    border-bottom: 1px solid var(--border);
  }
  .modellist li:first-child a { border-top: 1px solid var(--border); }
  .modellist a:hover { background: var(--bg-sunken); }
  .modellist__code { font-weight: 700; color: var(--accent); }
  .modellist__name { font-family: var(--font-serif); font-weight: 600; }
  .modellist__span { font-size: 0.875rem; color: var(--text-faint); }
  .modellist__profile { font-size: 0.9375rem; color: var(--text-muted); }
  @media (max-width: 820px) {
    .modellist a { grid-template-columns: 3.5rem 1fr; row-gap: 0.25rem; }
    .modellist__span, .modellist__profile { grid-column: 2; }
  }

  /* steps */
  .steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(195px, 1fr)); gap: 2.5rem; }
  .step__n { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.1em; color: var(--accent); }
  .step h3 { font-size: 1.125rem; margin: 0.5rem 0; }
  .step p { font-size: 0.9375rem; color: var(--text-muted); }

  .areas { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 0.75rem; }
  .area {
    display: flex; flex-direction: column; gap: 0.125rem;
    padding: 0.875rem 1rem; text-decoration: none;
    background: var(--bg-raised);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition: box-shadow .15s, transform .15s;
  }
  .area:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .area strong { font-size: 0.9375rem; color: var(--text); }
  .area span { font-size: 0.8125rem; color: var(--text-faint); }

  /* cta */
  .cta { background: var(--bg-inverse); color: var(--text-inverse); padding-block: clamp(3rem, 7vw, 5rem); }
  .cta__inner { display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .cta h2 { font-size: clamp(1.625rem, 3.6vw, 2.25rem); margin-bottom: 0.625rem; }
  .cta p { color: color-mix(in srgb, currentColor 74%, transparent); max-width: 52ch; }
  .btn--lg { padding: 1rem 2.25rem; font-size: 1rem; }
</style>
