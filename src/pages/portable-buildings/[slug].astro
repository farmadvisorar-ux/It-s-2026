---
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import pb from '../../data/portable-buildings.json';
import { portableImage, portableImages, planImage, detailImages } from '../../lib/images';
import { priceFor, priceFrom, monthlyFrom, hasPricing, termFor, usd } from '../../lib/pricing';
import site from '../../data/site.json';

export function getStaticPaths() {
  const { products } = pb as any;
  return products.map((p: any) => ({ params: { slug: p.slug }, props: { product: p } }));
}

// getStaticPaths returns `any`, so without this the inferred prop type
// collapses to `never` and every field access below is a type error.
const { product } = Astro.props as { product: any };
const { line, construction, categories, products } = pb as any;

const category = categories.find((c: any) => c.slug === product.category);
const related = products
  .filter((p: any) => p.category === product.category && p.slug !== product.slug)
  .slice(0, 4);

const fmtSize = (s: string) => {
  const [w, l] = s.split('x');
  return `${w}' × ${l}'`;
};
const sqft = (s: string) => {
  const [w, l] = s.split('x').map(Number);
  return w * l;
};
const isSpecialty = product.warrantyClass === 'specialty';
const gallery = portableImages(product.slug).slice(1);
const planShots = product.plans.map((n: string) => ({ n, src: planImage(n) })).filter((x: any) => x.src);
const details = detailImages();

// Pricing is optional per product. When absent, everything below renders
// exactly as it did before pricing existed.
const priced = hasPricing(product);
const fromCash = priceFrom(product);
const fromMonthly = monthlyFrom(product);
const term = termFor(product);

/**
 * Product schema, emitted only when this building actually has prices.
 * Without an offer, Product earns a permanent "missing field" warning in
 * Search Console and no rich result — which is why the steel kits, quoted per
 * site, do not carry it. Here the offer is real, so the markup is too.
 */
const cashPrices = (product.sizes ?? [])
  .map((s: string) => priceFor(product, s)?.cash)
  .filter((n: number | undefined): n is number => typeof n === 'number');

const productSchema = cashPrices.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      description: product.headline,
      category: category?.name,
      ...(portableImage(product.slug)
        ? { image: new URL(portableImage(product.slug)!, Astro.site ?? Astro.url.origin).href }
        : {}),
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'USD',
        lowPrice: Math.min(...cashPrices),
        highPrice: Math.max(...cashPrices),
        offerCount: cashPrices.length,
        availability: 'https://schema.org/InStock',
        seller: { '@type': 'Organization', name: site.name },
      },
    }
  : null;
const stateNames: Record<string, string> = {
  TX: 'Texas', LA: 'Louisiana', MO: 'Missouri', IL: 'Illinois', TN: 'Tennessee', IN: 'Indiana',
};
---

<Base
  title={product.name}
  description={`${product.name} — ${product.headline}. ${product.sizes.length} size${product.sizes.length === 1 ? '' : 's'}, delivered finished and ready to use.`}
  image={`/og/portable/${product.slug}.jpg`}
  crumbs={[{ label: 'Portable Buildings', href: '/portable-buildings/' }]}
  current={product.name}
>
  {productSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  )}
  <article>
    <section class="head">
      <div class="wrap head__inner">
        <div>
          <p class="eyebrow">{category?.name}</p>
          <h1 class="page-title">{product.name}</h1>
          <p class="head__line">{product.headline}</p>
          {fromCash && (
            <p class="head__price">
              <strong>From {usd(fromCash)}</strong> delivered
              {fromMonthly && term && <span class="head__price-alt"> · or {usd(fromMonthly)}/mo over {term} months</span>}
            </p>
          )}
          <div class="head__actions">
            <a class="btn btn--primary" href={`/quote/?line=portable&model=${product.slug}`}>Quote this building</a>
            <a class="btn btn--ghost" href={`/design/${product.slug}/`}>Customise in 3D</a>
            <a class="btn btn--ghost" href="/portable-buildings/#construction">How it is built</a>
          </div>
        </div>
        <Placeholder label={product.name} src={portableImage(product.slug)} alt={`${product.name} — ${product.headline}`} variant="wide" />
      </div>
    </section>

    <section class="section">
      <div class="wrap body-grid">
        <div class="prose">
          <p class="lede">{product.intro}</p>
          <h2>Worth knowing</h2>
          <p>{product.detail}</p>

          <h2>Features</h2>
          <ul>
            {product.features.map((f: string) => <li>{f}</li>)}
          </ul>

          <h2>Common uses</h2>
          <ul>
            {product.uses.map((u: string) => <li>{u}</li>)}
          </ul>

          <h2>Available sizes</h2>
          <div class="table-scroll">
            <table class="spec size-table">
              <thead>
                <tr>
                  <th scope="col">Size</th>
                  <th scope="col">Footprint</th>
                  {priced && <th scope="col">Price</th>}
                  {priced && term && <th scope="col">Per month</th>}
                </tr>
              </thead>
              <tbody>
                {product.sizes.map((s: string) => (
                  <tr>
                    <td class="mono">{fmtSize(s)}</td>
                    <td class="mono">{sqft(s).toLocaleString()} sq ft</td>
                    {priced && (
                      <td class="mono price">{priceFor(product, s)?.cash ? usd(priceFor(product, s)!.cash!) : '—'}</td>
                    )}
                    {priced && term && (
                      <td class="mono price">
                        {priceFor(product, s)?.monthly ? `${usd(priceFor(product, s)!.monthly!)}/mo` : '—'}
                      </td>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {priced && (
            <p class="price-note">
              Prices are for the building delivered and set on level ground within our
              delivery area{term ? `, and the monthly figure is a ${term}-month rent-to-own payment` : ''}.
              Lease-purchase terms come from the finance provider, not from us, and can change.
            </p>
          )}
          <h2>Floor plans</h2>
          <p>
            The floor plan sets where the doors and windows go. This model is offered in
            {' '}{product.plans.length} plan{product.plans.length === 1 ? '' : 's'} — the same
            building, laid out differently. Tell us how you will approach it and what goes
            inside, and the right one is usually obvious.
          </p>
          <div class="plans">
            {planShots.map((x: any) => (
              <figure class="plan">
                <img src={x.src} alt={`Floor plan ${x.n} for the ${product.name}`} loading="lazy" decoding="async" />
                <figcaption>Plan {x.n}</figcaption>
              </figure>
            ))}
          </div>
        </div>

        <aside class="side">
          <div class="panel">
            <h2 class="panel__head">At a glance</h2>
            <div class="table-scroll">
              <table class="spec">
                <tbody>
                  <tr><th scope="row">Category</th><td>{category?.name}</td></tr>
                  <tr><th scope="row">Sizes</th><td>{product.sizes.length}</td></tr>
                  <tr><th scope="row">Floor plans</th><td>{product.plans.length}</td></tr>
                  {product.height && <tr><th scope="row">Height</th><td>{product.height}</td></tr>}
                  <tr><th scope="row">Foundation</th><td>Treated skids — level ground, no slab</td></tr>
                  <tr><th scope="row">Delivery</th><td>Delivered finished and ready to use</td></tr>
                  <tr>
                    <th scope="row">Warranty</th>
                    <td>{isSpecialty ? '1-year limited' : '5-year limited'}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          {isSpecialty && (
            <div class="panel panel--warn">
              <h2 class="panel__head">Specialty warranty</h2>
              <p class="panel__note">
                Specialty models carry a <strong>1-year</strong> limited warranty rather than the
                5-year term on standard buildings. Worth knowing before you compare.
              </p>
            </div>
          )}

          <div class="panel">
            <h2 class="panel__head">Delivery area</h2>
            <ul class="states">
              {line.deliveryStates.map((s: string) => (
                <li><abbr title={stateNames[s]}>{s}</abbr></li>
              ))}
            </ul>
            <p class="panel__note">{line.deliveryNote}</p>
          </div>

          <div class="panel panel--accent">
            <h2 class="panel__head">Monthly payments</h2>
            <p class="panel__note">
              Rent-to-own and traditional financing are both available through third-party
              providers. Availability varies by area.
            </p>
            <a class="btn btn--primary" href="/quote/?line=portable" style="width:100%;justify-content:center;margin-top:0.875rem">Ask about payments</a>
          </div>
        </aside>
      </div>
    </section>

    {gallery.length > 0 && (
      <section class="section gallery-sec">
        <div class="wrap">
          <h2 class="sec-title">More of the {product.name}</h2>
          <div class="gallery">
            {gallery.map((src: string, i: number) => (
              <figure class="gallery__item">
                <img src={src} alt={`${product.name} view ${i + 2}`} loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section section--sunken">
      <div class="wrap">
        <h2 class="sec-title">How it is built</h2>
        <div class="grid grid--4 build-grid">
          {construction.map((c: any, i: number) => (
            <div class="build">
              {details[i] && <img class="build__img" src={details[i]} alt={`${c.area} construction detail`} loading="lazy" decoding="async" />}
              <p class="build__area">{c.area}</p>
              <ul>
                {c.points.slice(0, 3).map((pt: string) => <li>{pt}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="section">
        <div class="wrap">
          <h2 class="sec-title">Other {category?.name.toLowerCase()}</h2>
          <div class="grid grid--4">
            {related.map((p: any) => (
              <a class="card" href={`/portable-buildings/${p.slug}/`}>
                <Placeholder label={p.name} src={portableImage(p.slug)} alt={p.name} />
                <div class="card__body">
                  <h3 class="card__title">{p.name}</h3>
                  <p class="card__text">{p.headline}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .head { padding-block: clamp(2rem, 5vw, 3.5rem); border-bottom: 1px solid var(--border); }
  .head__inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .head :global(.ph), .head :global(.ph-img) { border-radius: var(--radius-lg); border: 1px solid var(--border); }
  .page-title { font-size: clamp(1.875rem, 4.5vw, 3rem); margin-block: 0.5rem 0.75rem; }
  .head__line { font-size: 1.125rem; color: var(--text-muted); }
  .head__price { margin-top: 0.875rem; font-size: 1.0625rem; }
  .head__price strong { color: var(--accent); }
  .head__price-alt { color: var(--text-muted); font-size: 0.9375rem; }
  .price { white-space: nowrap; }
  .price-note { margin-top: 0.75rem; font-size: 0.8125rem; color: var(--text-faint); }
  .head__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  .body-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .side { display: grid; gap: 1.25rem; position: sticky; top: 88px; }
  .panel { background: var(--bg-raised); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.25rem; }
  .panel--accent { border-color: color-mix(in srgb, var(--accent) 40%, transparent); background: color-mix(in srgb, var(--accent) 6%, var(--bg-raised)); }
  .panel--warn { border-color: color-mix(in srgb, #b45309 45%, transparent); background: color-mix(in srgb, #b45309 7%, var(--bg-raised)); }
  .panel__head { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-faint); margin-bottom: 0.875rem; }
  .panel__note { font-size: 0.8125rem; color: var(--text-muted); line-height: 1.6; }
  .panel .spec th, .panel .spec td { padding: 0.5rem 0; font-size: 0.875rem; }
  .panel .spec th { width: 45%; padding-right: 0.75rem; }

  .states { list-style: none; padding: 0; display: flex; gap: 0.375rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .states li {
    font-family: var(--font-mono); font-weight: 700; font-size: 0.8125rem;
    padding: 0.25rem 0.5rem; border-radius: 3px;
    background: var(--bg-sunken); border: 1px solid var(--border-strong); color: var(--accent);
  }
  .states abbr { text-decoration: none; }

  .size-table { background: var(--bg-raised); border: 1px solid var(--border); border-radius: var(--radius-lg); }
  .size-table thead th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-faint); background: var(--bg-sunken); }
  .mono { font-family: var(--font-mono); font-size: 0.875rem; }
  .fine { font-size: 0.8125rem; color: var(--text-faint); margin-top: 0.75rem; }

  .sec-title { font-size: clamp(1.375rem, 3vw, 1.875rem); margin-bottom: 1.5rem; }

  .plans { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 1rem; margin: 1.25rem 0 1rem; }
  .plan { margin: 0; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: #fff; }
  .plan img { width: 100%; height: auto; display: block; background: #fff; }
  .plan figcaption {
    font-family: var(--font-mono); font-size: 0.75rem; text-align: center;
    padding: 0.4375rem; background: var(--bg-sunken); color: var(--text-muted);
    border-top: 1px solid var(--border);
  }

  .gallery-sec { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
  .gallery__item { margin: 0; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-raised); }
  .gallery__item img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }

  .build__img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--radius); margin-bottom: 0.75rem; }
  .build-grid { gap: 1.75rem; }
  .build { border-top: 2px solid var(--accent); padding-top: 0.875rem; }
  .build__area { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-faint); margin-bottom: 0.5rem; }
  .build ul { margin: 0 0 0 1.125rem; padding: 0; font-size: 0.875rem; color: var(--text-muted); }
  .build li { margin-bottom: 0.375rem; }

  @media (max-width: 900px) {
    .head__inner, .body-grid { grid-template-columns: 1fr; }
    .side { position: static; }
  }
</style>
