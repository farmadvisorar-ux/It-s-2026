---
import site from '../data/site.json';

/**
 * Plain horizontal nav. No mega menu: the category depth that used to hang off
 * the header now lives on the index pages themselves, which is where it can be
 * shown with photographs instead of six columns of links.
 *
 * On narrow screens the same list becomes a full-screen overlay rather than a
 * dropdown, so the whole nav is one thumb-reachable column.
 */
const nav = [
  { href: '/building-types/', label: 'Steel Buildings' },
  { href: '/portable-buildings/', label: 'Portable Buildings' },
  { href: '/inventory/', label: 'Clearance' },
  { href: '/options-and-finishes/', label: 'Options' },
  { href: '/service-area/', label: 'Service Area' },
  { href: '/resources/', label: 'Resources' },
  { href: '/about/', label: 'About' },
];

const showPhone = Boolean(site.phone) && !site.phonePending;
---

<header class="site-header">
  <a href="#main" class="skip">Skip to content</a>
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
        <path
          fill="currentColor"
          fill-rule="evenodd"
          d="M16 2.6 24.4 7.2 30 12.4 30 29.4 2 29.4 2 12.4 7.6 7.2 Z M12.4 29.4 12.4 18.6 19.6 18.6 19.6 29.4 Z"
        />
      </svg>
      <span class="brand__text">
        <span class="brand__name">Marshall</span>
        <span class="brand__sub">Sheds</span>
      </span>
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
      <span class="visually-hidden">Menu</span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>

    <nav id="primary-nav" class="nav" aria-label="Primary">
      <ul class="nav__list">
        {nav.map((item) => (
          <li><a class="nav__link" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <div class="nav__end">
        {showPhone && (
          <a class="nav__tel" href={`tel:${site.phoneRaw || site.phone}`} aria-label={`Call ${site.phone}`}>
            {site.phone}
          </a>
        )}
        <a class="btn btn--primary nav__cta" href="/quote/">Get a Quote</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .skip {
    position: absolute; left: -9999px; top: 0; z-index: 100;
    background: var(--accent); color: var(--accent-contrast);
    padding: 0.75rem 1.25rem; text-decoration: none; font-weight: 600;
  }
  .skip:focus { left: 0; }

  /* Not sticky and not translucent — the page scrolls away from the header
     rather than under a blurred bar. */
  .site-header { background: var(--bg); }
  .header-inner { display: flex; align-items: center; gap: 2rem; min-height: 88px; }

  .brand { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--text); flex-shrink: 0; }
  .brand__mark { width: 34px; height: 34px; color: var(--accent); }
  .brand__text { display: flex; flex-direction: column; line-height: 1.05; }
  .brand__name { font-family: var(--font-serif); font-size: 1.3125rem; font-weight: 700; }
  .brand__sub {
    font-size: 0.6875rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.22em; color: var(--text-faint);
  }

  .nav { display: flex; align-items: center; gap: 1.75rem; margin-left: auto; }
  .nav__list { display: flex; align-items: center; gap: 1.25rem; list-style: none; padding: 0; margin: 0; }
  .nav__link {
    font-size: 0.9375rem; font-weight: 500; white-space: nowrap;
    text-decoration: none; color: var(--text-muted);
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }
  .nav__link:hover { color: var(--text); border-bottom-color: var(--accent); }
  .nav__end { display: flex; align-items: center; gap: 1rem; }
  .nav__tel { font-weight: 600; font-size: 0.9375rem; white-space: nowrap; text-decoration: none; color: var(--text); }
  .nav__tel:hover { color: var(--accent); }

  .nav-toggle { display: none; }

  @media (max-width: 1220px) {
    .header-inner { min-height: 72px; }
    .nav-toggle {
      display: grid; place-items: center; margin-left: auto;
      width: 44px; height: 44px; background: none;
      border: 1px solid var(--border-strong); border-radius: 999px; cursor: pointer;
      position: relative; z-index: 60;
    }
    .nav-toggle__bar, .nav-toggle__bar::before, .nav-toggle__bar::after {
      content: ''; display: block; width: 18px; height: 2px; background: var(--text); position: relative;
      transition: transform .18s, opacity .18s;
    }
    .nav-toggle__bar::before { position: absolute; top: -6px; }
    .nav-toggle__bar::after { position: absolute; top: 6px; }
    .nav-toggle[aria-expanded='true'] .nav-toggle__bar { background: transparent; }
    .nav-toggle[aria-expanded='true'] .nav-toggle__bar::before { transform: translateY(6px) rotate(45deg); }
    .nav-toggle[aria-expanded='true'] .nav-toggle__bar::after { transform: translateY(-6px) rotate(-45deg); }

    /* Full-screen overlay, not a dropdown. */
    .nav {
      position: fixed; inset: 0; z-index: 55;
      flex-direction: column; align-items: stretch; justify-content: center;
      gap: 2.5rem; margin: 0;
      background: var(--bg);
      padding: 5rem var(--gutter) 3rem;
      overflow-y: auto;
      display: none;
    }
    .nav[data-open='true'] { display: flex; }
    .nav__list { flex-direction: column; align-items: stretch; gap: 0; }
    .nav__link {
      display: block; padding: 0.875rem 0; white-space: normal;
      font-family: var(--font-serif); font-size: 1.5rem; font-weight: 600; color: var(--text);
      border-bottom: 1px solid var(--border);
    }
    .nav__link:hover { border-bottom-color: var(--border); color: var(--accent); }
    .nav__end { flex-direction: column; align-items: stretch; gap: 1rem; }
    .nav__tel { font-size: 1.125rem; }
    .nav__cta { justify-content: center; }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('primary-nav');

  function setOpen(open: boolean) {
    nav?.setAttribute('data-open', String(open));
    toggle?.setAttribute('aria-expanded', String(open));
    // The overlay covers the page, so the page behind it must not scroll.
    document.body.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setOpen(nav?.getAttribute('data-open') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.getAttribute('data-open') === 'true') {
      setOpen(false);
      (toggle as HTMLElement | null)?.focus();
    }
  });
</script>
