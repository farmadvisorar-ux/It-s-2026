{
  "name": "any-size",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:meta": "node scripts/check-meta.mjs",
    "make:icons": "node scripts/make-icons.mjs",
