  },
  "dependencies": {
    "astro": "^4.16.18",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/three": "^0.185.4",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3"
  }
}
